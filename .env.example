# Copy this file to .env or configure these values in the process environment.
# Never commit real credentials or personal account identifiers.

# Trading client
LIMIT_UP_CLIENT_NAME=GJ_SIM
LIMIT_UP_EXECUTION_MODE=simulation
LIMIT_UP_ENABLE_SHADOW_SIGNAL=false
# Persistent paper/shadow execution assumptions (decimal rates)
LIMIT_UP_PAPER_INITIAL_CASH=1000000
LIMIT_UP_PAPER_COMMISSION_RATE=0.0003
LIMIT_UP_PAPER_MIN_COMMISSION=5
LIMIT_UP_PAPER_STAMP_DUTY_RATE=0.0005
LIMIT_UP_PAPER_TRANSFER_FEE_RATE=0.00001
LIMIT_UP_PAPER_SLIPPAGE_BPS=2
LIMIT_UP_PAPER_PARTICIPATION_RATE=0.10
LIMIT_UP_PAPER_ALLOW_T0=false
LIMIT_UP_PAPER_DB=output/paper_trading
GJ_SIM_QMT_CLIENT_PATH=
GJ_SIM_STOCK_ACCOUNT=
CICC_QMT_CLIENT_PATH=
CICC_STOCK_ACCOUNT=
XTQUANT_HOST=127.0.0.1
XTQUANT_PORT=58610
# Optional: directory containing the xtquant package, for example
# C:\QMT\bin.x64\Lib\site-packages. The launcher also tries common QMT paths.
XTQUANT_PYTHONPATH=
LIMIT_UP_LOG_DIR=logs/monitor
AI_HOTSPOT_LOG_DIR=logs/ai_hotspot_trader
TICK_DATA_DIR=output/tick_data
LEVEL2_DATA_DIR=output/level2
LEVEL2_DATE=
LEVEL2_MERGED_DIR=
IWENCAI_SECTOR_URL=

# Email notifications
SMTP_HOST=smtp.qq.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_RECIPIENT=

# Optional FTPS report publishing
REPORT_FTP_HOST=
REPORT_FTP_USERNAME=
REPORT_FTP_PASSWORD=
REPORT_FTP_REMOTE_DIR=/site/wwwroot/reports
REPORT_FTP_TEST_REMOTE_DIR=/site/wwwroot/test

# Optional LLM providers
AZURE_API_KEY=
AZURE_ENDPOINT=
DASHSCOPE_API_KEY=
DASHSCOPE_ENDPOINT=https://coding.dashscope.aliyuncs.com/v1
GITHUB_TOKEN=
THS_MARKET_ANALYSIS_TOKEN=
THS_MARKET_ANALYSIS_URL=https://eq.10jqka.com.cn/webpage/kamis-renderer/index.html
EASTMONEY_UT_TOKENS=
